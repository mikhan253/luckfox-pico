#!/bin/sh
echo ">>> rc.startup gestartet."
CONFIGDATA=/mnt/userdata/config

mount -t proc proc /proc

echo "Attach UBI..."
ubiattach -m 5 /dev/ubi_ctrl

echo "Mounte Filesystems von fstab..."
mkdir -p /dev/pts
mkdir -p /dev/shm
mount -a

echo "Netzwerk vorbereiten..."
touch /run/resolv.conf
hostname -F ${CONFIGDATA}/hostname

echo "WiFi vorbereiten..."
modprobe r8723bs
mkdir /run/config_wifi
for file in ${CONFIGDATA}/wifi/*; do
    if [ -f "$file" ]; then
        ln -s "$file" "/var/lib/iwd/$(basename "$file")"
    fi
done

echo "Runit vorbereiten..."
for service in /etc/sv/*; do
    [ -d "$service" ] || continue
    svc_name=$(basename "$service")
    mkdir -p "/run/${svc_name}_supervise"
    echo "Created /run/${svc_name}_supervise"
done

echo ">>> rc.startup fertig."