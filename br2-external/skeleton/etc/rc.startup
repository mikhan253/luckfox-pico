#!/bin/sh
echo ">>> rc.startup gestartet."
echo "Mounte System-Filesystems..."
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp

echo "Attach UBI..."
ubiattach -m 5 /dev/ubi_ctrl

echo "Mounte Filesystems von fstab..."
mount -a

echo "WiFi vorbereiten..."
modprobe r8723bs
mount -t tmpfs tmpfs /var/lib/iwd/
cp /etc/iwd/wifi/* /var/lib/iwd/
touch /run/resolv.conf

echo ">>> rc.startup fertig."
